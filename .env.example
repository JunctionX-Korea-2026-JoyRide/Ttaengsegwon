# LLM API Configuration (Upstage Solar, OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://api.upstage.ai/v1
LLM_MODEL=solar-pro4

# Public Data & External Services
PUBLIC_DATA_API_KEY=

# Naver Cloud Maps API
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# Naver Developers Search API (Local Search)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# MCP Configuration
MCP_SERVER_URL=
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=

# Gyeongbuk MCP (local stdio server, run via `uv`)
# Absolute path to the gyeongbuk-mcp repo checkout, e.g. /Users/you/Documents/GitHub/gyeongbuk-mcp
GYEONGBUK_MCP_DIR=
