#!/bin/sh
set -e

echo "🔍 [Pre-commit] 1/3 Checking and formatting staged files..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.(ts|tsx|js|jsx|json|css|md)$' || true)
if [ -n "$STAGED_FILES" ]; then
    for file in $STAGED_FILES; do
        if [ -f "$file" ]; then
            yarn prettier --write "$file"
            git add "$file"
        fi
    done
fi

echo "🔍 [Pre-commit] 2/3 Running ESLint..."
yarn next lint

echo "🔍 [Pre-commit] 3/3 Running TypeScript type check..."
yarn tsc --noEmit

echo "✅ [Pre-commit] All checks passed successfully!"
